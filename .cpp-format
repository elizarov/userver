# See $strictfmt/docs/format.md for details
---
ColumnLimit: 120
IndentWidth: 4
TabWidth: 4

MacroCategories:
  BareIdentifierMacros:
    - ATOMIC_FLAG_INIT
    - ALIGN
    - _W64
    - _inline
    - __cdecl
    - WINAPI
    - USERVER_IMPL_NODEBUG
    - USERVER_IMPL_NODEBUG_INLINE_FUNC
    - USERVER_IMPL_FORCE_INLINE
    - USERVER_IMPL_DISABLE_ASAN
    - USERVER_IMPL_ALWAYS_INLINE_SIMD
    - USERVER_IMPL_LIFETIME_BOUND*
    - USERVER_FMT_CONST*
    - USERVER_IMPL_LIBC_INCLUDE_FIXES_THROW*
    - USERVER_IMPL_PROTECT_DWCAS_ATTR
    - ATTRIBUTE_NO_SANITIZE_UNDEFINED
    - BOOST_FORCEINLINE
    - BOOST_NOEXCEPT_OR_NOTHROW*
    - PRId64
    - PRIu64
    - USERVER_MOVE_ONLY_FUNCTION_CV
    - USERVER_MOVE_ONLY_FUNCTION_REF
    - USERVER_MOVE_ONLY_FUNCTION_CVREF
    - USERVER_MOVE_ONLY_FUNCTION_INVOKE_QUALS
    - USERVER_NAMESPACE_BEGIN
    - USERVER_NAMESPACE_END
    - CURL_8_13_NAMESPACE
    - CURL_SSLVERSION_NAMESPACE
    - BENCHMARK_THREAD_ARGS*
  DeclarationPrefixMacros:
    - ALIGN
    - _W64
    - _inline
    - __cdecl
    - WINAPI
    - USERVER_IMPL_NODEBUG
    - USERVER_IMPL_NODEBUG_INLINE_FUNC
    - USERVER_IMPL_FORCE_INLINE
    - USERVER_IMPL_DISABLE_ASAN
    - USERVER_IMPL_ALWAYS_INLINE_SIMD
    - USERVER_FMT_CONST*
    - USERVER_IMPL_LIBC_INCLUDE_FIXES_THROW*
    - USERVER_IMPL_PROTECT_DWCAS_ATTR
    - ATTRIBUTE_NO_SANITIZE_UNDEFINED
    - BOOST_FORCEINLINE
  CallSyntaxMacros:
    - TEST
    - TEST_F
    - TEST_P
    - TEST_COMMAND
    - UTEST_F_DEATH
    - UTEST_F_MT
    - UTEST_P_MT
    - UTEST_MT
    - UTEST_DEATH
    - UTEST_F
    - UTEST_P
    - UTEST
    - BENCHMARK
    - BENCHMARK_CAPTURE
    - BENCHMARK_DEFINE_F
    - BENCHMARK_DEFINE_TEMPLATE_F
    - BENCHMARK_F
    - BENCHMARK_INSTANTIATE_TEMPLATE_F
    - BENCHMARK_MAIN
    - BENCHMARK_REGISTER_F
    - BENCHMARK_TEMPLATE
    - MOCK_METHOD
    - MATCHER
    - MATCHER_P
    - INSTANTIATE_TEST_SUITE_P
    - INSTANTIATE_TYPED_TEST_SUITE_P
    - INSTANTIATE_TYPED_UTEST_SUITE_P
    - INSTANTIATE_UTEST_SUITE_P
    - REGISTER_TYPED_TEST_SUITE_P
    - REGISTER_TYPED_UTEST_SUITE_P
    - TYPED_TEST
    - TYPED_TEST_P
    - TYPED_TEST_SUITE
    - TYPED_TEST_SUITE_P
    - TYPED_UTEST
    - TYPED_UTEST_MT
    - TYPED_UTEST_P
    - TYPED_UTEST_P_MT
    - TYPED_UTEST_SUITE
    - TYPED_UTEST_SUITE_P
    - USERVER_DEFINE_STRUCT_SUBSET
    - USERVER_DEFINE_STRUCT_SUBSET_REF
  SemicolonlessCallMacros:
    - RET_NAME
    - UTILS_STRONG_TYPEDEF_REL_OP
  StatementArgumentMacros:
    - UEXPECT_THROW
    - UEXPECT_NO_THROW
    - UEXPECT_THROW_MSG
    - UASSERT_NO_THROW
    - EXPECT_FATAL_FAILURE
    - EXPECT_NONFATAL_FAILURE
    - EXPECT_THROW
    - EXPECT_NO_THROW
    - EXPECT_ANY_THROW
    - ASSERT_THROW
    - ASSERT_NO_THROW
    - ASSERT_ANY_THROW
  TypeSpecifierMacros:
    - STACK_OF
